{
  "name": "inuneko-dex",
  "version": "2.0.0",
  "description": "いぬねこ図鑑 — スマホをはなれて、そだてるたまごっち",
  "private": true,
  "scripts": {
    "test": "node tests/test_engine.js",
    "snap": "NODE_PATH=$(npm root -g) node tests/visual/snapshot.js",
    "e2e": "NODE_PATH=$(npm root -g) node tests/e2e/e2e.js",
    "build:web": "rm -rf docs/app && cp -r www docs/app && node tools/cachebust.mjs && echo 'built docs/app (GitHub Pages: /dog_cat/app/)'",
    "sync": "cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "tar": ">=7.5.21",
    "uuid": ">=11.1.1",
    "minimatch": ">=10.2.6"
  }
}
