{
  "name": "inuneko-dex",
  "version": "2.0.0",
  "description": "いぬねこ図鑑 — スマホをはなれて、そだてるたまごっち",
  "private": true,
  "scripts": {
    "test": "node tests/test_engine.js",
    "snap": "NODE_PATH=$(npm root -g) node tests/visual/snapshot.js",
    "e2e": "NODE_PATH=$(npm root -g) node tests/e2e/e2e.js",
    "store:shots": "NODE_PATH=$(npm root -g) node tools/gen_store_shots.js",
    "build:web": "rm -rf docs/app && cp -r www docs/app && node tools/cachebust.mjs && echo 'built docs/app (GitHub Pages: /dog_cat/app/)'",
    "sync": "cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "sharp": "^0.32.6"
  }
}
